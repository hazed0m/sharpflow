# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google OAuth Configuration (REQUIRED for production)
# Set this to your exact redirect URL from Google Cloud Console:
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/v1/callback  # Development
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Vercel deployment - replace with your production URLs
VERCEL_ORIGINS=http://localhost:5173,https://your-app.vercel.app
VERCEL_DEPLOY_HOOKS=https://api.github.com/repos/hazed0m/sharpflow/actions/runs/6438902648/events

# Supabase Auth settings (optional - defaults work fine)
VITE_SUPABASE_AUTH_CUSTOM_REDIRECT_URI=http://localhost:5173/auth/v1/callback